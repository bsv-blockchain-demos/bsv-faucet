# https://vercel.com/docs/storage/vercel-postgres
POSTGRES_URL=
POSTGRES_DATABASE=
POSTGRES_URL_NON_POOLING=
POSTGRES_URL_NO_SSL=
POSTGRES_PRISMA_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Clerk webhook signing secret (svix). Server-only.
WEBHOOK_SECRET=

NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Treasury wallet private key (WIF). Server-only.
TREASURY_WALLET_WIF=
# WhatsOnChain API key. Optional but strongly recommended: without it the
# faucet shares the public per-IP rate limit and gets HTTP 429s. Server-only.
WOC_API_KEY=
NEXT_PUBLIC_MAX_DAILY_WITHDRAWAL=
