# PostgreSQL connection string, used by the app and by Prisma migrations.
POSTGRES_PRISMA_URL=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Clerk webhook signing secret (svix). Server-only.
WEBHOOK_SECRET=

# Treasury wallet private key (WIF). Server-only.
TREASURY_WALLET_WIF=
# WhatsOnChain API key. Optional but strongly recommended: without it the
# faucet shares the public per-IP rate limit and gets HTTP 429s. Server-only.
WOC_API_KEY=
NEXT_PUBLIC_MAX_DAILY_WITHDRAWAL=

# Wallet (BRC-100) sign-in. Off unless set to true.
NEXT_PUBLIC_WALLET_AUTH_ENABLED=
# The faucet's own auth key, as hex. Generate a new one per environment with
# PrivateKey.fromRandom().toHex() from @bsv/sdk. Never the treasury key.
# Server-only.
FAUCET_AUTH_PRIVATE_KEY=
# Name shown in wallet approval prompts. Leave unset to use the page's own
# domain, which is right for any deployment, fork or preview.
NEXT_PUBLIC_WALLET_ORIGINATOR=
# Development only: direct wallet URL (for example http://127.0.0.1:3321) for
# when the wallet's local HTTPS certificate is not trusted. Unset in production.
NEXT_PUBLIC_BSV_WALLET_URL=

# Phone wallet sign-in by QR code. Off unless set to true. Needs the relay
# service in relay/ running somewhere (Railway in production).
NEXT_PUBLIC_WALLET_RELAY_ENABLED=
# The relay's HTTPS base URL, for example https://relay.bsvfaucet.com, or
# http://localhost:3021 with the relay running locally. Build-time: the app
# proxies /wallet-relay/api/* and /api/session/:id to it. Server-only.
WALLET_RELAY_URL=
