# Copy to .env for local runs. Railway takes the same names as service variables.

# Port to listen on. Railway sets PORT itself.
PORT=3021

# Public WebSocket address of this relay, which the faucet hands to the phone.
# Must be wss:// anywhere except localhost. Production: wss://relay.bsvfaucet.com
RELAY_URL=ws://localhost:3021

# The faucet's public origin. It is embedded in the QR code and shown to the
# user on the phone, and the phone fetches the relay address from it.
# Production: https://bsvfaucet.com. Local: http://localhost:3000
ORIGIN=http://localhost:3000

# Optional comma-separated allowlist of browser origins that may create
# sessions. Leave unset to accept the ORIGIN above only.
# ALLOWED_ORIGINS=https://bsvfaucet.com,https://www.bsvfaucet.com

# The relay's own private key, as hex. The phone derives its shared secret
# from this key's public half, so it must stay the same across restarts.
# A dedicated key: never the faucet's auth key and never the treasury key.
# Generate one with:
#   node -e "const {PrivateKey}=require('@bsv/sdk'); console.log(PrivateKey.fromRandom().toHex())"
WALLET_RELAY_PRIVATE_KEY=
