{
  "name": "bsv-faucet",
  "version": "1.0.0",
  "private": true,
  "description": "Testnet BSV faucet for developers building on the BSV blockchain.",
  "keywords": [
    "bsv",
    "bitcoin-sv",
    "testnet",
    "faucet"
  ],
  "author": "BSV Association",
  "license": "Apache-2.0",
  "homepage": "https://bsvfaucet.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/bsv-blockchain-demos/bsv-faucet.git"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "prisma:generate": "prisma generate",
    "prisma:db:seed": "dotenvx run -f .env.local -- prisma db seed",
    "prisma:migrate:dev": "dotenvx run -f .env.local -- prisma migrate dev",
    "prisma:migrate:reset": "dotenvx run -f .env.local -- prisma migrate reset",
    "prisma:studio": "dotenvx run -f .env.local -- prisma studio"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "prettier": {
    "arrowParens": "always",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "none"
  },
  "dependencies": {
    "@bsv/auth": "0.1.4",
    "@bsv/sdk": "^2.7.1",
    "@bsv/wallet-relay": "0.5.0",
    "@clerk/nextjs": "^6.39.6",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@tanstack/react-table": "^8.20.5",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "bs58check": "^4.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "csv-stringify": "^6.5.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.454.0",
    "next": "^16.3.3",
    "node-cron": "^3.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "svix": "^1.37.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.55.1",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.23",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "overrides": {
      "base-x": ">=5.0.1",
      "cross-spawn": ">=7.0.5",
      "glob@>=10": ">=10.5.0",
      "minimatch@>=9": ">=9.0.7",
      "nanoid": ">=3.3.8",
      "diff": ">=4.0.3",
      "picomatch": ">=4.0.4",
      "yaml": ">=2.8.3",
      "brace-expansion": ">=5.0.8",
      "form-data": ">=4.0.6",
      "postcss": ">=8.5.23",
      "sharp": ">=0.35.3",
      "uuid": ">=11.1.1"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "express",
        "@types/express",
        "qrcode"
      ]
    }
  },
  "packageManager": "pnpm@9.12.2+sha512.22721b3a11f81661ae1ec68ce1a7b879425a1ca5b991c975b074ac220b187ce56c708fe5db69f4c962c989452eee76c82877f4ee80f474cebd61ee13461b6228"
}
